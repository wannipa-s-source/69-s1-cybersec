###api

## 1. Admin

### 1.1 Login
# @name login
POST {{$dotenv API_BASE_URL}}/admin/login
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_EMAIL}}",
    "password": "{{$dotenv ADMIN_PASSWORD}}",
    "rememberMe": false
}

### 1.2 Register / Signup
POST {{$dotenv API_BASE_URL}}/admin/register-admin
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_EMAIL}}",
    "password": "{{$dotenv ADMIN_REGISTER_PASSWORD}}",
    "firstname": "{{$dotenv ADMIN_FIRSTNAME}}",
    "lastname": "{{$dotenv ADMIN_LASTNAME}}"
}

### 1.3 Forgot
POST {{$dotenv API_BASE_URL}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{$dotenv ADMIN_EMAIL}}"
}

### 1.3.1 Reset Password
POST {{$dotenv API_BASE_URL}}/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{$dotenv ADMIN_RESET_TOKEN}}",
    "password": "{{$dotenv ADMIN_PASSWORD}}"
}

### 1.4 Profile
GET {{$dotenv API_BASE_URL}}/admin/me
Authorization: Bearer {{login.response.body.$.data.token}}


# 2.USER

### 2.1 User Login
POST {{$dotenv API_BASE_URL}}/api/auth/local
content-type: application/json

{
  "identifier": "{{$dotenv USER_EMAIL}}",
  "password": "{{$dotenv USER_PASSWORD}}"
}

### 2.2 User Register
POST {{$dotenv API_BASE_URL}}/api/auth/local/register
Content-Type: application/json

{
  "username": "{{$dotenv USER_USERNAME}}",
  "email": "{{$dotenv USER_EMAIL}}",
  "password": "{{$dotenv USER_REGISTER_PASSWORD}}"
}

### 2.3 User Forgot
POST {{$dotenv API_BASE_URL}}/api/auth/forgot-password
content-type: application/json

{
  "email": "{{$dotenv USER_FORGOT_EMAIL}}"
}

### 2.3.1 User Reset Password
POST {{$dotenv API_BASE_URL}}/api/auth/reset-password
content-type: application/json

{
  "code": "{{$dotenv USER_RESET_CODE}}",
  "password": "{{$dotenv USER_RESET_PASSWORD}}",
  "passwordConfirmation": "{{$dotenv USER_RESET_PASSWORD_CONFIRM}}"
}

### 2.4 User Profile
GET {{$dotenv API_BASE_URL}}/api/users/me
Authorization: Bearer {{$dotenv USER_JWT_TOKEN}}